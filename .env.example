# Database configuration
DATABASE_PASSWORD="your-database-password" # Replace with your actual database password, keep empty for XAMPP default
AI_API_URL="your-api-url-here" # Replace with your actual API URL (Only works with OpenAI-compatible API for now)
AI_API_KEY="your-api-key-here" # Replace with your actual API key
AI_MODEL="enter-model-id-here" # Replace with your actual AI model, e.g., "gpt-5.4" or "gpt-5.4-mini"